<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>RustyWatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Katalogi języków + instrukcja są kopiowane do %APPDATA% przy pierwszym starcie. -->
    <Content Include="Localization\*.json;Localization\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Domyślna czcionka tarczy (SIL OFL 1.1) + jej licencja. -->
    <Content Include="Assets\Fonts\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Logo aplikacji: ikona okna/exe oraz znak na stronie HOME. -->
    <Content Include="Assets\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Assets\AppIcon.ico;Assets\Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Wbudowany zestaw wskazówek zegara analogowego. -->
    <Content Include="Assets\Hands\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Wbudowana paczka ikon stanu systemu: Classic (domyślna). -->
    <Content Include="Assets\Status\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Wbudowana paczka ikon pogody: Classic. -->
    <Content Include="Assets\Weather\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Weather\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Weather\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <PropertyGroup>
    <RustFfiConfig Condition="'$(Configuration)' == 'Release'">release</RustFfiConfig>
    <RustFfiConfig Condition="'$(RustFfiConfig)' == ''">debug</RustFfiConfig>
    <RustFfiBuildArgs Condition="'$(RustFfiConfig)' == 'release'">--release</RustFfiBuildArgs>
  </PropertyGroup>

  <Target Name="BuildRustFfi" BeforeTargets="Build">
    <Exec Command="cargo build -p rusty-ffi $(RustFfiBuildArgs)" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
  </Target>

  <!-- Kopiujemy jawnie po kompilacji: PreserveNewest potrafi pominąć świeżo zbudowany DLL. -->
  <Target Name="CopyRustFfi" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\target\$(RustFfiConfig)\rusty_ffi.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>

  <!-- Publish nie traktuje DLL-a jako content — kopiujemy go jawnie do PublishDir. -->
  <Target Name="CopyRustFfiToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\target\$(RustFfiConfig)\rusty_ffi.dll"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <!-- Skompilowane zasoby XAML (.xbf) i PRI aplikacji też giną przy publish. -->
  <Target Name="CopyWinUIAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_AppXbf Include="$(OutDir)**/*.xbf" />
      <_AppPri Include="$(OutDir)RustyWatch.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppXbf)"
          DestinationFiles="@(_AppXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_AppPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
